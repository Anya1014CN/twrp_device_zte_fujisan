# TWRP fstab for ZTE Axon M Z999 (fujisan)
#
# This fstab exposes every eMMC GPT partition for raw backup.  Image flashing
# is restricted to partitions supplied by the 9008 package's rawprogram0.xml.
# Only 9008-package partitions with a real file system appear on Mount.
#
# mount point    fstype    block device                                      flags

# Primary backup selection and UI order.  Data is deliberately not flashable.
/boot            emmc      /dev/block/bootdevice/by-name/boot                flags=display="Boot";backup=1;flashimg=1
/recovery        emmc      /dev/block/bootdevice/by-name/recovery            flags=display="Recovery";backup=1;flashimg=1
/system          ext4      /dev/block/bootdevice/by-name/system              flags=display="System";backup=1;flashimg=1
/data            f2fs      /dev/block/bootdevice/by-name/userdata            flags=display="Data";backup=1;wipeingui;forceencrypt=/dev/block/bootdevice/by-name/cryptkey

# Full GPT backup list, in on-device order after the primary UI entries.
# flashimg=1 is reserved for 9008 package image targets.
/xbl             emmc      /dev/block/bootdevice/by-name/xbl                 flags=display="XBL";backup=1;flashimg=1
/xblbak          emmc      /dev/block/bootdevice/by-name/xblbak              flags=display="XBL Backup";backup=1;flashimg=1
/tz              emmc      /dev/block/bootdevice/by-name/tz                  flags=display="TrustZone";backup=1;flashimg=1
/rpm             emmc      /dev/block/bootdevice/by-name/rpm                 flags=display="RPM";backup=1;flashimg=1
/hyp             emmc      /dev/block/bootdevice/by-name/hyp                 flags=display="Hypervisor";backup=1;flashimg=1
/fbop            emmc      /dev/block/bootdevice/by-name/fbop                flags=display="FBO Partition";backup=1
/pmic            emmc      /dev/block/bootdevice/by-name/pmic                flags=display="PMIC";backup=1;flashimg=1
/fsg             emmc      /dev/block/bootdevice/by-name/fsg                 flags=display="FSG";backup=1
/firmware        vfat      /dev/block/bootdevice/by-name/modem               flags=display="Modem";backup=1;flashimg=1;fsflags=ro,shortname=lower,uid=1000,gid=1000,dmask=227,fmask=337;mounttodecrypt
/modemst1        emmc      /dev/block/bootdevice/by-name/modemst1            flags=display="ModemST1";backup=1
/modemst2        emmc      /dev/block/bootdevice/by-name/modemst2            flags=display="ModemST2";backup=1
/cdt             emmc      /dev/block/bootdevice/by-name/cdt                 flags=display="CDT";backup=1
/reserve         emmc      /dev/block/bootdevice/by-name/reserve             flags=display="Reserve";backup=1
/ddr             emmc      /dev/block/bootdevice/by-name/ddr                 flags=display="DDR";backup=1;flashimg=1
/sec             emmc      /dev/block/bootdevice/by-name/sec                 flags=display="Secure Config";backup=1;flashimg=1
/ztecfg          emmc      /dev/block/bootdevice/by-name/ztecfg              flags=display="ZTE Config";backup=1
/aboot           emmc      /dev/block/bootdevice/by-name/aboot               flags=display="Aboot";backup=1;flashimg=1
/keymaster       emmc      /dev/block/bootdevice/by-name/keymaster           flags=display="Keymaster";backup=1
/cmnlib          emmc      /dev/block/bootdevice/by-name/cmnlib              flags=display="CMNLib";backup=1;flashimg=1
/cmnlib64        emmc      /dev/block/bootdevice/by-name/cmnlib64            flags=display="CMNLib64";backup=1;flashimg=1
/dsp             ext4      /dev/block/bootdevice/by-name/dsp                 flags=display="DSP";backup=1;flashimg=1;fsflags=ro,nosuid,nodev,barrier=1
/dip             emmc      /dev/block/bootdevice/by-name/dip                 flags=display="DIP";backup=1
/mdtp            emmc      /dev/block/bootdevice/by-name/mdtp                flags=display="MDTP";backup=1;flashimg=1
/devinfo         emmc      /dev/block/bootdevice/by-name/devinfo             flags=display="Device Info";backup=1
/apdp            emmc      /dev/block/bootdevice/by-name/apdp                flags=display="APDP";backup=1;flashimg=1
/msadp           emmc      /dev/block/bootdevice/by-name/msadp               flags=display="MSADP";backup=1;flashimg=1
/dpo             emmc      /dev/block/bootdevice/by-name/dpo                 flags=display="DPO";backup=1
/splash          emmc      /dev/block/bootdevice/by-name/splash              flags=display="Splash";backup=1;flashimg=1
/echarge         emmc      /dev/block/bootdevice/by-name/echarge             flags=display="ECharge";backup=1;flashimg=1
/bluetooth       vfat      /dev/block/bootdevice/by-name/bluetooth           flags=display="Bluetooth";backup=1;flashimg=1;fsflags=ro,shortname=lower,uid=1002,gid=3002,dmask=227,fmask=337
/fsc             emmc      /dev/block/bootdevice/by-name/fsc                 flags=display="FSC";backup=1
/ssd             emmc      /dev/block/bootdevice/by-name/ssd                 flags=display="SSD";backup=1
/cache           emmc      /dev/block/bootdevice/by-name/cache               flags=display="Cache";backup=1
/persist         emmc      /dev/block/bootdevice/by-name/persist             flags=display="Persist";backup=1
/misc            emmc      /dev/block/bootdevice/by-name/misc                flags=display="Misc";backup=1
/keystore        emmc      /dev/block/bootdevice/by-name/keystore            flags=display="Keystore";backup=1
/devcfg          emmc      /dev/block/bootdevice/by-name/devcfg              flags=display="Device Config";backup=1;flashimg=1
/frp             emmc      /dev/block/bootdevice/by-name/frp                 flags=display="FRP";backup=1
/fingerid        emmc      /dev/block/bootdevice/by-name/fingerid            flags=display="Fingerprint ID";backup=1;flashimg=1
/ztebak1         emmc      /dev/block/bootdevice/by-name/ztebak1             flags=display="ZTE Backup";backup=1
/cryptkey        emmc      /dev/block/bootdevice/by-name/cryptkey            flags=display="CryptKey";backup=1
/lksecapp        emmc      /dev/block/bootdevice/by-name/lksecapp            flags=display="LK Secure App";backup=1;flashimg=1
/sti             emmc      /dev/block/bootdevice/by-name/sti                 flags=display="STI";backup=1
/dcmlog          emmc      /dev/block/bootdevice/by-name/dcmlog              flags=display="DCM Log";backup=1

/external_sd     vfat      /dev/block/mmcblk1p1      /dev/block/mmcblk1      flags=display="Micro SDcard";storage;wipeingui;removable
/usb_otg         vfat      /dev/block/sda1           /dev/block/sda          flags=display="USB OTG";storage;wipeingui;removable
