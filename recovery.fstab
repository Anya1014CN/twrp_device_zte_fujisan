# TWRP fstab for ZTE Axon M Z999 (fujisan)
# mount point    fstype    block device                                      flags

/system          ext4      /dev/block/bootdevice/by-name/system              flags=display="System";backup=1
/data            f2fs      /dev/block/bootdevice/by-name/userdata            flags=display="Data";backup=1;wipeingui;forceencrypt=/dev/block/bootdevice/by-name/cryptkey
/cache           ext4      /dev/block/bootdevice/by-name/cache               flags=display="Cache";backup=1;wipeingui
/persist         ext4      /dev/block/bootdevice/by-name/persist             flags=display="Persist";backup=1
/dcmlog          ext4      /dev/block/bootdevice/by-name/dcmlog              flags=display="DcmLog";backup=1

/boot            emmc      /dev/block/bootdevice/by-name/boot                flags=display="Boot";backup=1;flashimg=1
/recovery        emmc      /dev/block/bootdevice/by-name/recovery            flags=display="Recovery";backup=1;flashimg=1
/misc            emmc      /dev/block/bootdevice/by-name/misc                flags=display="Misc"
/cryptkey        emmc      /dev/block/bootdevice/by-name/cryptkey            flags=display="CryptKey";backup=1

/modem           emmc      /dev/block/bootdevice/by-name/modem               flags=display="Modem";backup=1
/bluetooth       emmc      /dev/block/bootdevice/by-name/bluetooth           flags=display="Bluetooth";backup=1
/dsp             emmc      /dev/block/bootdevice/by-name/dsp                 flags=display="DSP";backup=1
/fsg             emmc      /dev/block/bootdevice/by-name/fsg                 flags=display="FSG";backup=1
/modemst1        emmc      /dev/block/bootdevice/by-name/modemst1            flags=display="Modemst1";backup=1
/modemst2        emmc      /dev/block/bootdevice/by-name/modemst2            flags=display="Modemst2";backup=1
/splash          emmc      /dev/block/bootdevice/by-name/splash              flags=display="Splash";backup=1;flashimg=1

/external_sd     vfat      /dev/block/mmcblk1p1      /dev/block/mmcblk1      flags=display="Micro SDcard";storage;wipeingui;removable
/usb_otg         vfat      /dev/block/sda1           /dev/block/sda          flags=display="USB OTG";storage;wipeingui;removable
